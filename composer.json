{
    "name": "tuanbtre/csm",
    "type": "library",
    "description": "Laravel CMS package with admin panel, user management, and content system",
    "version": "2.1.1",
    "license": "MIT",
	"authors": [{
            "name": "Nguyen Minh Tuan",
            "email": "tuancsharp@gmail.com"
        }],
    "require": {
		"php": "^8.0",
		"laravel/ui": "^4.2",
		"spatie/laravel-analytics": "^5.0",
        "intervention/image-laravel": "^1.0",
        "unisharp/laravel-filemanager": "^2.5"
	},
	"extra": {
        "laravel": {
            "providers": [
                "Tuanbtre\\Csm\\CsmServiceProvider"
            ]
        }
    },
	"autoload": {
        "psr-4": {
            "Tuanbtre\\Csm\\": "src/"
        },
		"files":[
            "src/helpers/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
			"Tests\\": "tests/"
        }
    }
}
